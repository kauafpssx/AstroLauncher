{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AstroLauncher",
  "version": "0.4.0",
  "identifier": "com.astrolauncher.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AstroLauncher",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "backgroundColor": "#0A0A0A",
        "dragDropEnabled": false
      },
      {
        "label": "splash",
        "title": "AstroLauncher",
        "url": "splash.html",
        "width": 360,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "backgroundColor": "#0A0A0A"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/assets/icons/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  },
  "plugins": {
    "env": {
      "api": {
        "curseforge": "https://api.curseforge.com/v1",
        "mcstat": "https://mcstat.org/api/v1",
        "playermc": "https://api.playermc.site/v1",
        "modrinth": "https://api.modrinth.com/v2",
        "mojangManifest": "https://launchermeta.mojang.com/mc/game/version_manifest_v2.json",
        "mojangAssets": "https://resources.download.minecraft.net",
        "adoptium": "https://api.adoptium.net/v3",
        "fabricMeta": "https://meta.fabricmc.net/v2",
        "quiltMeta": "https://meta.quiltmc.org/v3",
        "liteloaderVersions": "http://dl.liteloader.com/versions/versions.json",
        "liteloaderRepo": "http://repo.liteloader.com/",
        "mavenCentral": "https://repo1.maven.org/maven2/"
      },
      "githubRepo": "kauafpssx/AstroLauncher",
      "mcstatDashboard": "https://mcstat.org/dashboard/api-keys",
      "mcstatDocs": "https://mcstat.org/api-docs",
      "curseforgeConsole": "https://console.curseforge.com/"
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzODdENTdGQUVCRjYwRUYKUldUdllMK3VmOVdIc3dheUFDaXd2eVNLSWl6WGVmWDkveHBoRlFBOE92UldWbjk1eUZQUEcxQkwK",
      "endpoints": [
        "https://github.com/kauafpssx/AstroLauncher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    },
    "discord": {
      "clientId": "1533653025842008145",
      "logoAssetKey": "logo"
    }
  }
}

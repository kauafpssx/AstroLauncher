# ═══════════════════════════════════════════════════════════════════
# .gitignore — AstroLauncher
# ═══════════════════════════════════════════════════════════════════

# ── Logs ────────────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Dependências ────────────────────────────────────────────────────
node_modules
.pnp
.pnp.js

# ── Build e produção ────────────────────────────────────────────────
dist
dist-ssr
coverage
.nyc_output
*.local

# ── TypeScript ──────────────────────────────────────────────────────
*.tsbuildinfo
.eslintcache

# ── Ambiente ────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Editores e IDEs ─────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Sistema operacional ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Rust / Tauri ────────────────────────────────────────────────────
src-tauri/target
src-tauri/gen

# ── Tauri updater signing keys (nunca commitar) ─────────────────────
.keys
*.key
*.sig
